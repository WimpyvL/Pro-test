# Required for Clerk frontend auth.
VITE_CLERK_PUBLISHABLE_KEY=""

# Optional when the frontend is not reverse-proxied through Vite.
# Example: VITE_API_BASE_URL="https://api.example.com"
# If the frontend and backend share one domain through a reverse proxy,
# use a path prefix like "/api" and rewrite that prefix to the Encore service.
VITE_API_BASE_URL=""

# Optional local override for Vite's dev proxy target.
# Example: VITE_LOCAL_API_PROXY_TARGET="http://127.0.0.1:4000"
VITE_LOCAL_API_PROXY_TARGET=""
