{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the game tester.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "name": { "type": "string", "description": "Display name of the tester." },
        "email": { "type": "string", "format": "email", "description": "Email address of the tester." },
        "photoURL": { "type": "string", "description": "URL to the user's profile picture." },
        "status": { "type": "string", "enum": ["online", "offline"], "description": "Current presence status." },
        "lastSeen": { "type": "string", "format": "date-time", "description": "Last time the user was active." },
        "role": { "type": "string", "enum": ["tester", "admin"], "description": "User role." },
        "stats": {
          "type": "object",
          "properties": {
            "totalReports": { "type": "integer" },
            "fixedReports": { "type": "integer" }
          }
        }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Game": {
      "title": "Game",
      "description": "A game available for testing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "thumbnail": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "url"]
    },
    "BugReport": {
      "title": "Bug Report",
      "description": "A report of a bug found during testing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the report." },
        "authorUid": { "type": "string", "description": "UID of the tester who created the report." },
        "authorName": { "type": "string", "description": "Name of the tester who created the report." },
        "timestamp": { "type": "number", "description": "Time the report was created." },
        "image": { "type": "string", "description": "Base64 or URL of the original screenshot." },
        "annotatedImage": { "type": "string", "description": "Base64 or URL of the annotated screenshot." },
        "title": { "type": "string", "description": "Title of the bug report." },
        "description": { "type": "string", "description": "Detailed description of the bug." },
        "status": { "type": "string", "enum": ["open", "pending", "fixed"], "description": "Current status of the bug." },
        "aiAnalysis": { "type": "string", "description": "AI-generated analysis of the bug." }
      },
      "required": ["id", "authorUid", "timestamp", "image", "title", "status"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Collection of tester profiles."
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Collection of games available for testing."
    },
    "/reports/{reportId}": {
      "schema": "BugReport",
      "description": "Collection of bug reports shared across the team."
    }
  }
}
